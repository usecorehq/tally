{
  "name": "@tally/db",
  "version": "0.0.1",
  "private": true,
  "description": "Tally drizzle schema + client — `tally` schema in the shared Qorelly Supabase project.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@tally/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3"
  }
}
