# Server-only. The browser never sees the client secret or any OAuth token.
TALLY_API_URL=https://<tally api host>/api
TALLY_AUTHORIZE_URL=https://<tally mp host>/oauth/authorize
TALLY_EMBED_ORIGIN=https://embed.tally.qorelly.com
TALLY_CLIENT_ID=tc_
TALLY_CLIENT_SECRET=
# This app's own https origin; the redirect URI is ${DEMO_BASE_URL}/callback.
DEMO_BASE_URL=https://<demo host>
# At least 32 random characters; signs the session cookie.
SESSION_SECRET=
PORT=4200
