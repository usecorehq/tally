%%{init: {"theme": "neutral"} }%%
flowchart TB
    merchant["<b>Merchant</b><br/><i>[Person]</i><br/>Runs a Nigerian SME: counts<br/>and manages stock"]

    tally["<b>Tally</b><br/><i>[Software System]</i><br/>Photo-to-inventory and stock-taking<br/>(web + mobile)"]

    qorellyAuth["<b>Qorelly Supabase</b><br/><i>[External System]</i><br/>Shared project: auth.users (identity)<br/>+ Postgres hosting the tally schema"]
    catalog["<b>Qore Catalog API</b><br/><i>[External System]</i><br/>Nigerian commerce product dataset<br/>(/v1, x-api-key)"]
    meta["<b>Meta Model API</b><br/><i>[External System]</i><br/>Muse Spark, SAM 3.1"]
    r2["<b>Cloudflare R2</b><br/><i>[External System]</i><br/>Tally's own files (tally-media)"]

    merchant -- "Signs in, counts and manages stock<br/>[HTTPS: mp web, mobile app]" --> tally
    tally -- "Signs users in, verifies JWTs,<br/>stores tally data" --> qorellyAuth
    tally -- "Matches products, sends feedback and crops<br/>[HTTPS, x-api-key]" --> catalog
    tally -- "Recognises products in photos<br/>[HTTPS, Bearer]" --> meta
    tally -- "Stores product crops<br/>[S3 API]" --> r2

    classDef person fill:#08427b,stroke:#052e56,color:#fff
    classDef container fill:#1168bd,stroke:#0b4884,color:#fff
    classDef external fill:#999999,stroke:#6b6b6b,color:#fff
    classDef planned fill:#ffffff,stroke:#1168bd,color:#1168bd,stroke-dasharray: 5 3
    classDef boundary fill:#ffffff,stroke:#999999,color:#333,stroke-dasharray: 4 3
    class merchant person
    class tally container
    class qorellyAuth,catalog,meta,r2 external
