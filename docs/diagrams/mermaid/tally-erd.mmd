%%{init: {"theme": "neutral"} }%%
erDiagram
    AUTH_USERS ||--o{ BUSINESSES : "owns (owner_user_id)"
    AUTH_USERS ||--o{ BUSINESS_MEMBERS : "is (user_id)"
    BUSINESSES ||--o{ BUSINESS_MEMBERS : has
    BUSINESSES ||--o{ INVENTORY_ITEMS : stocks
    BUSINESSES ||--o{ SALES : records
    INVENTORY_ITEMS ||--o{ STOCK_MOVEMENTS : "moves (append-only)"
    SALES ||--|{ SALE_ITEMS : contains
    INVENTORY_ITEMS ||--o{ SALE_ITEMS : "sold as"
    SALES ||--o{ SALE_PAYMENTS : "paid by"
    SALES |o--o{ STOCK_MOVEMENTS : "sale / void"

    AUTH_USERS {
        uuid id PK "auth schema (Qorelly)"
    }
    BUSINESSES {
        uuid id PK
        uuid owner_user_id FK
        text name
        text vertical_code "Qore Catalog taxonomy"
        text subtype_code "Qore Catalog taxonomy"
        text currency "NGN"
        int sale_counter "next_sale_number()"
    }
    BUSINESS_MEMBERS {
        uuid business_id FK
        uuid user_id FK
        text role "owner | staff"
    }
    INVENTORY_ITEMS {
        uuid id PK
        uuid business_id FK
        text core_qid "Qore Catalog product, nullable"
        text name
        numeric price "12,2 NGN"
        numeric cost
        numeric quantity_on_hand "trigger-maintained"
        text source "template | photo | manual"
    }
    STOCK_MOVEMENTS {
        uuid id PK
        uuid item_id FK
        text type "opening | restock | sale | adjustment | void"
        numeric quantity_delta
        numeric quantity_after "set by trigger"
        uuid sale_id FK "sale / void only"
        text client_movement_id "idempotency"
    }
    SALES {
        uuid id PK
        uuid business_id FK
        int sale_number "per business"
        text status "completed | voided"
        numeric subtotal
        numeric discount
        numeric total "= subtotal - discount"
        numeric paid_amount "SUM(sale_payments), trigger"
        timestamptz stock_deducted_at "idempotency stamp"
        text client_sale_id "idempotency"
    }
    SALE_ITEMS {
        uuid sale_id FK
        uuid item_id FK
        text item_name "as sold"
        numeric unit_price "as sold"
        numeric quantity
        numeric line_total
    }
    SALE_PAYMENTS {
        uuid sale_id FK
        numeric amount "> 0"
        text method "cash | transfer | card | other"
        text client_payment_id "idempotency"
    }
