%%{init: {"theme": "neutral"} }%%
erDiagram
    AUTH_USERS ||--o{ BUSINESSES : "owns (owner_user_id)"
    AUTH_USERS ||--o{ BUSINESS_MEMBERS : "is (user_id)"
    BUSINESSES ||--o{ BUSINESS_MEMBERS : has
    BUSINESSES ||--o{ INVENTORY_ITEMS : stocks
    INVENTORY_ITEMS ||--o{ STOCK_MOVEMENTS : "moves (append-only)"
    BUSINESSES ||--o{ VISION_SCANS : "scans shelves"
    VISION_SCANS ||--o{ VISION_DETECTIONS : finds
    INVENTORY_ITEMS |o--o{ VISION_DETECTIONS : "looks like"
    INVENTORY_ITEMS |o--o{ VISION_DETECTIONS : "decided as"
    INVENTORY_ITEMS ||--o{ INVENTORY_ITEM_READINGS : "recognised by"
    BUSINESSES ||--o{ VISION_AGENT_RUNS : "stock-takes"
    VISION_AGENT_RUNS ||--o{ VISION_AGENT_STEPS : "trace"
    VISION_AGENT_RUNS |o--o| VISION_SCANS : "result"

    AUTH_USERS {
        uuid id PK "auth schema (Qorelly)"
    }
    BUSINESSES {
        uuid id PK
        uuid owner_user_id FK
        text name
        text vertical_code "Qore Catalog taxonomy"
        text subtype_code "Qore Catalog taxonomy"
        text currency "NGN"
    }
    BUSINESS_MEMBERS {
        uuid business_id FK
        uuid user_id FK
        text role "owner | staff"
    }
    INVENTORY_ITEMS {
        uuid id PK
        uuid business_id FK
        text core_qid "Qore Catalog product, nullable"
        text name
        numeric price "12,2 NGN"
        numeric cost
        numeric quantity_on_hand "trigger-maintained"
        text source "template | photo | manual"
    }
    STOCK_MOVEMENTS {
        uuid id PK
        uuid item_id FK
        text type "opening | restock | adjustment"
        numeric quantity_delta
        numeric quantity_after "set by trigger"
        text client_movement_id "idempotency"
    }
    VISION_SCANS {
        uuid id PK
        uuid business_id FK
        text status "open | confirmed | discarded | superseded"
        text image_sha256 "photo not stored here"
        text read_model "muse-spark-1.3"
        text count_model "sam-3.1"
    }
    VISION_DETECTIONS {
        uuid id PK
        uuid scan_id FK
        int position "scan_id:position = feedback ref"
        text brand "as read"
        text name "as read"
        text pack "as read"
        int count "SAM, else Spark"
        jsonb candidates "Qore IDs, scores, match only"
        uuid inventory_item_id FK "nullable"
        text inventory_match "reading | catalogue | name"
        text action "restock | restore | add | skip"
        uuid item_id FK "decided as, nullable"
    }
    INVENTORY_ITEM_READINGS {
        uuid item_id FK
        text reading_key "brand|name|pack, unique per business"
    }
    VISION_AGENT_RUNS {
        uuid id PK
        uuid scan_id FK "result, nullable"
        text status "running | done | fallback | failed"
        int turns
        int input_tokens
        int output_tokens
    }
    VISION_AGENT_STEPS {
        uuid run_id FK
        int turn
        text kind "baseline | thought | tool"
        text tool
        text summary "no image data"
    }
