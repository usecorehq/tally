# Single root env for local dev. Copy to .env — never commit real values.

# Qore Catalog API
QORE_CATALOG_BASE_URL=http://localhost:3100
QORE_CATALOG_API_KEY=

# Shared Qorelly Supabase project (tally schema, Qorelly auth.users)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# drizzle-kit (pnpm db:migrate) + apps/api. Staging only.
SUPABASE_DB_URL=

# apps/api
PORT=4100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# console + mp (NextAuth / Auth.js v5)
AUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:4100/api
