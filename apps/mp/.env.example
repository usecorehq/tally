# apps/mp — Next loads apps/mp/.env; anything missing falls back to the repo-root .env.

# NextAuth v5 — openssl rand -base64 32
AUTH_SECRET=
# Shared Qorelly Supabase project (sign-in)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only — used in server components, never NEXT_PUBLIC_
QORE_CATALOG_BASE_URL=http://localhost:3100
QORE_CATALOG_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:4100/api
