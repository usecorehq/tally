# Copy to .env.dev / .env.staging / .env.prod and fill in per environment.
# Passed at build/run time with --dart-define-from-file=.env.<flavor>; never committed.
# Public values only — never a service-role key or the Qore Catalog key.

# Shared Qorelly Supabase project
SUPABASE_URL=
# Publishable key (a legacy anon key also works)
SUPABASE_PUBLISHABLE_KEY=

# apps/api base URL, e.g. https://<host>/api. Required for staging and prod.
# Optional for dev (defaults to the local API: 10.0.2.2 on the Android emulator, 127.0.0.1 on iOS).
TALLY_API_URL=
