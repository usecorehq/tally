# apps/api — loaded from apps/api/.env, then the repo-root .env for anything missing.

PORT=4100
NODE_ENV=development
# Comma-separated. Empty = allow all in dev, none in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase project
SUPABASE_URL=https://iarynkpgyvjyvqvbdftp.supabase.co
SUPABASE_JWT_SECRET=
# Use the transaction pooler (port 6543): the session pooler (5432) has 15 slots shared with other Qorelly apps.
SUPABASE_DB_URL=
# Optional: connections this API process may hold (default 5).
DB_POOL_MAX=

# Connect Tally: signs partner access and embed tokens (HS256, at least 32 chars).
# Server-only. Ask the CTO for a value; never commit one. Required in production; unset elsewhere = token endpoint returns 503.
TALLY_CLIENT_JWT_SECRET=

# Qore Catalog API — server-only key, sent as x-api-key
QORE_CATALOG_BASE_URL=http://localhost:3100
# Server-only. Ask the CTO for a key; never commit one.
QORE_CATALOG_API_KEY=

# Meta Model API (Muse Spark, SAM 3.1) — camera recognition. Server-only bearer key.
META_MODEL_BASE_URL=https://api.meta.ai/v1
# Server-only. Ask the CTO for a key; never commit one. Unset = vision routes return 503.
META_MODEL_API_KEY=

# Cloudflare R2, bucket tally-media: Tally's own files (product crops) under tally/.
# Server-only; token scoped to that bucket. Unset = crops are not stored or sent to Qore Catalog.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tally-media
