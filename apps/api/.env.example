# apps/api — loaded from apps/api/.env, then the repo-root .env for anything missing.

PORT=4100
NODE_ENV=development
# Comma-separated. Empty = allow all in dev, none in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Shared Qorelly Supabase project
SUPABASE_URL=
# Supabase → Project Settings → API → JWT Settings (HS256 secret)
SUPABASE_JWT_SECRET=
# Postgres connection string (staging). Pooler URLs are detected automatically.
SUPABASE_DB_URL=

# Qore Catalog API — server-only key, sent as x-api-key
QORE_CATALOG_BASE_URL=http://localhost:3100
QORE_CATALOG_API_KEY=
