              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}"
              ]
            },
            "description": "One business (members only)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
