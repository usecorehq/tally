            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/inventory/{{itemId}}/barcode",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "inventory",
                "{{itemId}}",
                "barcode"
              ]
            },
            "description": "Link a barcode to an item (null unlinks). 409 when another item already has it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcode\": \"6156000024013\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
