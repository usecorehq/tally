              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/inventory/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "inventory",
                "{{itemId}}"
              ]
            },
            "description": "Archives, never deletes: keeps Qore ID, name, price, history; a later shelf scan offers to restore it."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Vision",
      "item": [
        {
          "name": "Shelf scan (photo → products)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/shelf-scans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "shelf-scans"
              ]
            },
            "description": "Attach a shelf photo in `image` (JPEG/PNG/WebP, ≤ 4 MB, ~1600 px long edge). Muse Spark reads the products, Qore Catalog matches them; each detection says if it's in stock, archived (restore) or new. Takes a few seconds. Saves `scanId` when returned.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Shelf photo"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); const v = b.scanId || b.id; if (v) pm.collectionVariables.set('scanId', typeof v === 'string' ? v : JSON.stringify(v));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get shelf scan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/shelf-scans/{{scanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "shelf-scans",
                "{{scanId}}"
              ]
            },
            "description": "A stored scan: detections, counts, candidate Qore IDs and scores, inventory match and decisions."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm shelf scan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/shelf-scans/{{scanId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "shelf-scans",
                "{{scanId}}",
                "confirm"
              ]
            },
            "description": "One decision per detection: restock (itemId), restore (archived itemId), add (name + price, qid when from the catalogue), or skip. Use detection ids from the scan. Catalogue matches are sent to Qore Catalog as feedback.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisions\": [\n    {\n      \"detectionId\": \"<detection id from the scan>\",\n      \"action\": \"add\",\n      \"qid\": \"{{qid}}\",\n      \"name\": \"Peak Full Cream Milk Powder 400g\",\n      \"price\": \"4500\",\n      \"quantity\": 6\n    },\n    {\n      \"detectionId\": \"<detection id>\",\n      \"action\": \"restock\",\n      \"itemId\": \"{{itemId}}\",\n      \"quantity\": 3\n    },\n    {\n      \"detectionId\": \"<detection id>\",\n      \"action\": \"skip\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start stock-take (agent)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/stocktakes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "stocktakes"
              ]
            },
            "description": "Thorough stock-take of a shelf photo (same image rules). Returns at once with `runId`; poll *Get stock-take*. About 1-2 minutes.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Shelf photo"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); const v = b.runId; if (v) pm.collectionVariables.set('runId', typeof v === 'string' ? v : JSON.stringify(v));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get stock-take",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/stocktakes/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "stocktakes",
                "{{runId}}"
              ]
            },
            "description": "Status (running, done, fallback, failed), the agent's steps so far, and when done the result in the shelf-scan shape. Confirm it with *Confirm shelf scan*."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); const v = b.scanId || (b.result && (b.result.scanId || b.result.id)); if (v) pm.collectionVariables.set('scanId', typeof v === 'string' ? v : JSON.stringify(v));"
                ]
              }
            }
          ]
        },
        {
          "name": "Identify one product",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/vision/identify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "vision",
                "identify"
              ]
            },
            "description": "Which of my items is this? One product photo in `image` (≤ 1 MB, ~640 px). Matches the merchant's items first, Qore Catalog only when nothing in store matches. Nothing is stored; ~3 s. Try the barcode first. Saves the reading for *Identify confirm*.",
            "body": {
              "mode": "formdata",
