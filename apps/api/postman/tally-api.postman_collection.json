            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); const v = (Array.isArray(b) ? b : (b.items || []))[0]?.id; if (v) pm.collectionVariables.set('itemId', typeof v === 'string' ? v : JSON.stringify(v));"
                ]
              }
            }
          ]
        },
        {
          "name": "Starter inventory (onboarding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/inventory/starter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "inventory",
                "starter"
              ]
            },
            "description": "Applies the onboarding template step: kept items become inventory with opening stock; every decision is sent to Qore Catalog as feedback. Safe to retry (clientRef). Prices are Naira strings.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"clientRef\": \"tpl-postman-1\",\n      \"templateItemName\": \"Garri\",\n      \"outcome\": \"accepted\",\n      \"suggestedQid\": \"{{qid}}\",\n      \"suggestedScore\": 0.62,\n      \"name\": \"Golden Penny Garri 1kg\",\n      \"price\": \"2600\",\n      \"openingQuantity\": 10\n    },\n    {\n      \"clientRef\": \"tpl-postman-2\",\n      \"templateItemName\": \"Spaghetti\",\n      \"outcome\": \"new_item\",\n      \"name\": \"Local Spaghetti 500g\",\n      \"price\": \"1200\",\n      \"openingQuantity\": 20\n    },\n    {\n      \"clientRef\": \"tpl-postman-3\",\n      \"templateItemName\": \"Beans\",\n      \"outcome\": \"removed\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find by barcode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/inventory/barcode/6156000024013",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "businesses",
                "{{businessId}}",
                "inventory",
                "barcode",
                "6156000024013"
              ]
            },
            "description": "Scan to find. 404 when no active item has this barcode."
